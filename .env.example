# ==========================================
# AgriWise Production Environment Variables
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET=agriwise_secure_jwt_secret_production_key_change_in_prod_2026
JWT_EXPIRES_IN=7d

# Database Configuration
# Provide PostgreSQL URL for production (e.g., postgresql://postgres:password@localhost:5432/agriwise)
# If left empty, AgriWise uses its built-in high-performance ACID relational file store.
DATABASE_URL=

# Weather API Configuration
# Optional: WeatherAPI key (https://www.weatherapi.com/)
# If empty, AgriWise automatically uses the Open-Meteo High-Resolution Global Meteorological API (No key required)
WEATHER_API_KEY=

# Gemini AI API Configuration (Injected automatically in AI Studio)
GEMINI_API_KEY=
